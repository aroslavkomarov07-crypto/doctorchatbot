# Public hostname without https:// and trailing slash
APP_DOMAIN=bot.example.com
APP_HOST=0.0.0.0
APP_PORT=5000
APP_LOG_LEVEL=INFO
APP_LOG_PATH=logs/doctorshop.log
BANNER_DIRECTORY=assets/banners
# Optional JSON mapping, for example: {"client_main":"AgAC..."}
BANNER_FILE_IDS={}

# Telegram
BOT_TOKEN=replace_me
BOT_SECRET_TOKEN=replace_with_random_secret
BOT_OWNER_ID=123456789
BOT_SUPPORT_USERNAME=support_username
PRIVACY_POLICY_URL=
USER_AGREEMENT_URL=
BOT_DROP_PENDING_UPDATES=false
# Local Docker Compose overrides this to true. Keep false in production webhook mode.
BOT_USE_POLLING=false

# PostgreSQL
DATABASE_HOST=doctorshop-db
DATABASE_PORT=5432
DATABASE_NAME=doctorshop
DATABASE_USER=doctorshop
DATABASE_PASSWORD=replace_me
DATABASE_ECHO=false

# Redis/Valkey
REDIS_HOST=doctorshop-redis
REDIS_PORT=6379
REDIS_NAME=0
REDIS_PASSWORD=

# Platega SBP. Leave empty to use FakeGateway in development.
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_SBP_PAYMENT_METHOD=

# Default used only during first bootstrap. Later edited by OWNER in the bot.
SERVICE_COMMISSION_PERCENT=13.00
