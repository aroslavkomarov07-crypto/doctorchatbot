BOT_TOKEN=123456:replace-me
OWNER_TELEGRAM_ID=123456789
SQL_ECHO=false

# Platega: configure the SBP method ID for your merchant account and set
# Callback URL to https://your-domain.example/webhooks/platega (POST).
PAYMENT_MODE=platega
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_SBP_PAYMENT_METHOD=
# Bind the webhook only to localhost when using a reverse proxy on this host.
WEB_BIND=127.0.0.1

# Development-only payment simulator; never enable for real sales.
PUBLIC_BASE_URL=
ALLOW_MOCK_PAYMENTS=false
MOCK_SECRET=

# Optional Docker database settings. Replace the password before deployment.
POSTGRES_DB=doctorchatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
